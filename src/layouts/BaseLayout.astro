---
import geistLatinFont from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import geistMonoLatinFont from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";
import SpeedInsights from "@vercel/speed-insights/astro";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import "../styles/global.css";

interface Props {
  description?: string;
  showNavbar?: boolean;
  title?: string;
  variant?: "default" | "showcase";
}

const {
  description = "developer",
  showNavbar = true,
  title = "artyom",
  variant = "default",
} = Astro.props;
const pageTitle = title === "artyom" ? "artyom" : `${title} | artyom`;
const site = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(Astro.url.pathname, site).toString();
const ogImageUrl = new URL("/og.png", site).toString();
---

<!doctype html>
<html
  lang="en"
  class="bg-white text-black dark:bg-black dark:text-white"
  data-site-theme="gruvbox"
>
  <head>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const themeModeKey = "theme-mode";
        const siteThemeKey = "site-theme";
        const siteThemes = [
          "gruvbox",
          "default",
          "slate",
          "mocha",
          "pine",
          "nord",
          "sage",
          "sand",
        ];
        const readStorage = (key) => {
          try {
            return localStorage.getItem(key);
          } catch {
            return null;
          }
        };

        try {
          localStorage.removeItem("theme");
          localStorage.removeItem("theme-preference");
        } catch {
          // Storage can be unavailable in strict browser modes.
        }

        const storedSiteTheme = readStorage(siteThemeKey);
        root.dataset.siteTheme =
          storedSiteTheme && siteThemes.includes(storedSiteTheme)
            ? storedSiteTheme
            : siteThemes[0];

        const storedTheme = readStorage(themeModeKey);
        root.classList.toggle("dark", storedTheme !== "light");
      })();
    </script>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content={description}>
    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    >
    <link rel="canonical" href={canonicalUrl}>
    <link
      rel="preload"
      href={geistLatinFont}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    >
    <link
      rel="preload"
      href={geistMonoLatinFont}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    >
    <link rel="icon" type="image/svg+xml" href="/icon.svg">
    <link rel="apple-touch-icon" href="/icon-192.png">
    <meta property="og:title" content={pageTitle}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:site_name" content="artyom">
    <meta property="og:locale" content="en_US">
    <meta property="og:type" content="website">
    <meta property="og:image" content={ogImageUrl}>
    <meta property="og:image:alt" content="Artyom Kulimov portfolio preview">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={pageTitle}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImageUrl}>
    <meta name="twitter:image:alt" content="Artyom Kulimov portfolio preview">
    <title>{pageTitle}</title>
  </head>
  <body
    class:list={[
    'antialiased',
    variant === 'showcase'
      ? ['mx-0 max-w-none', showNavbar && 'mt-8']
      : 'mx-4 mt-8 max-w-xl lg:mx-auto',
  ]}
  >
    <main
      class:list={[
      'flex-auto min-w-0 flex flex-col',
      variant === 'showcase' ? showNavbar && 'mt-6' : 'mt-0',
      variant === 'showcase' ? 'px-0' : 'px-2 md:px-0',
    ]}
    >
      {showNavbar && <Navbar variant={variant} />}
      <slot />
      <Footer variant={variant} />
      <SpeedInsights />
    </main>
  </body>
</html>
