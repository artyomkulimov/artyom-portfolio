---
import PaletteToggle from "./PaletteToggle.astro";
import ShowcaseIcon from "./ShowcaseIcons.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  variant?: "default" | "showcase";
}

const { variant = "default" } = Astro.props;
---

{variant === 'showcase' ? (
  <header class="z-30 -mt-6 mb-0 w-full border-neutral-200 border-b bg-white/95 text-neutral-950 backdrop-blur dark:border-neutral-800 dark:bg-black/95 dark:text-neutral-50">
    <div class="mx-auto flex h-16 max-w-7xl items-center justify-start px-5 md:px-8">
      <a
        class="inline-grid h-10 grid-cols-[1rem_auto] items-center gap-2 text-sm leading-none text-neutral-600 transition-colors hover:text-neutral-950 dark:text-neutral-400 dark:hover:text-neutral-100"
        href="/"
      >
        <ShowcaseIcon name="arrow-left" class="h-4 w-4" />
        <span class="block leading-none">portfolio</span>
      </a>
    </div>
  </header>
) : (
  <>
    <aside class="pointer-events-none fixed top-3 left-4 z-50 tracking-tight sm:left-5">
      <div class="pointer-events-auto">
        <PaletteToggle />
      </div>
    </aside>
    <aside class="pointer-events-none fixed top-3 right-4 z-50 tracking-tight sm:right-5">
      <div class="pointer-events-auto">
        <ThemeToggle />
      </div>
    </aside>
  </>
)}
