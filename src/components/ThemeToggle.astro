<button
  type="button"
  class="fixed top-4 right-4 z-50 inline-flex h-9 w-9 items-center justify-center rounded-full border border-neutral-300 bg-white/85 text-neutral-700 shadow-sm backdrop-blur transition-colors hover:border-neutral-500 hover:text-neutral-950 dark:border-neutral-700 dark:bg-neutral-950/85 dark:text-neutral-300 dark:hover:border-neutral-500 dark:hover:text-white"
  data-theme-toggle
  aria-label="switch to dark mode"
  title="toggle theme"
>
  <svg
    aria-hidden="true"
    class="h-4 w-4 dark:hidden"
    fill="none"
    stroke="currentColor"
    stroke-linecap="round"
    stroke-linejoin="round"
    stroke-width="2"
    viewBox="0 0 24 24"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9" />
  </svg>
  <svg
    aria-hidden="true"
    class="hidden h-4 w-4 dark:block"
    fill="none"
    stroke="currentColor"
    stroke-linecap="round"
    stroke-linejoin="round"
    stroke-width="2"
    viewBox="0 0 24 24"
  >
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2" />
    <path d="M12 20v2" />
    <path d="m4.93 4.93 1.41 1.41" />
    <path d="m17.66 17.66 1.41 1.41" />
    <path d="M2 12h2" />
    <path d="M20 12h2" />
    <path d="m6.34 17.66-1.41 1.41" />
    <path d="m19.07 4.93-1.41 1.41" />
  </svg>
</button>

<script>
  const themeToggle = document.querySelector("[data-theme-toggle]");
  const root = document.documentElement;

  const getStoredTheme = () => localStorage.getItem("theme");
  const getCurrentTheme = () =>
    root.classList.contains("dark") ? "dark" : "light";

  const syncThemeButton = () => {
    if (!(themeToggle instanceof HTMLButtonElement)) {
      return;
    }

    const nextTheme = getCurrentTheme() === "dark" ? "light" : "dark";
    themeToggle.setAttribute("aria-label", `switch to ${nextTheme} mode`);
  };

  themeToggle?.addEventListener("click", () => {
    const nextTheme = getCurrentTheme() === "dark" ? "light" : "dark";
    root.classList.toggle("dark", nextTheme === "dark");
    localStorage.setItem("theme", nextTheme);
    syncThemeButton();
  });

  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", (event) => {
      if (getStoredTheme()) {
        return;
      }

      root.classList.toggle("dark", event.matches);
      syncThemeButton();
    });

  syncThemeButton();
</script>
