---
import SunMoon from "@lucide/astro/icons/sun-moon";
---

<button
  type="button"
  class="group/theme m-1 inline-flex h-7 items-center gap-1.5 px-2 font-mono text-[11px] leading-5 text-neutral-600 transition-[color,transform] duration-150 hover:text-neutral-800 active:scale-[0.97] focus-visible:outline-none dark:text-neutral-400 dark:hover:text-neutral-200"
  data-theme-toggle
  aria-label="switch to dark mode"
  title="toggle theme"
>
  <span
    aria-hidden="true"
    class="theme-toggle-icon-shell"
    data-theme-icon-shell
  >
    <SunMoon class="theme-toggle-icon h-3.5 w-3.5" />
  </span>
  <span data-theme-label>dark</span>
</button>

<script>
  const themeToggle = document.querySelector("[data-theme-toggle]");
  const themeIconShell = themeToggle?.querySelector("[data-theme-icon-shell]");
  const root = document.documentElement;
  const themeModeKey = "theme-mode";

  localStorage.removeItem("theme");
  localStorage.removeItem("theme-preference");

  const getStoredTheme = () => localStorage.getItem(themeModeKey);
  const getCurrentTheme = () =>
    root.classList.contains("dark") ? "dark" : "light";
  let themeRotation = getCurrentTheme() === "dark" ? 180 : 0;

  const rotateThemeIcon = () => {
    if (!(themeIconShell instanceof HTMLElement)) {
      return;
    }

    themeRotation += 180;
    themeIconShell.style.setProperty(
      "--theme-toggle-rotation",
      `${themeRotation}deg`
    );
  };

  const syncThemeButton = () => {
    if (!(themeToggle instanceof HTMLButtonElement)) {
      return;
    }

    const nextTheme = getCurrentTheme() === "dark" ? "light" : "dark";
    themeToggle.setAttribute("aria-label", `switch to ${nextTheme} mode`);
    themeToggle.querySelector("[data-theme-label]")?.replaceChildren(nextTheme);
  };

  themeToggle?.addEventListener("click", () => {
    const nextTheme = getCurrentTheme() === "dark" ? "light" : "dark";
    rotateThemeIcon();
    root.classList.toggle("dark", nextTheme === "dark");
    localStorage.setItem(themeModeKey, nextTheme);
    syncThemeButton();
  });

  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", (event) => {
      if (getStoredTheme()) {
        return;
      }

      root.classList.toggle("dark", event.matches);
      themeRotation = event.matches ? 180 : 0;
      themeIconShell?.removeAttribute("style");
      syncThemeButton();
    });

  syncThemeButton();
</script>

<style is:global>
  .theme-toggle-icon-shell {
    display: inline-flex;
    transform: rotate(var(--theme-toggle-rotation, 0deg));
    transform-origin: center;
    transform-box: fill-box;
    transition: transform 420ms cubic-bezier(0.65, 0, 0.35, 1);
  }

  html.dark .theme-toggle-icon-shell {
    --theme-toggle-rotation: 180deg;
  }

  .theme-toggle-icon {
    transform-origin: center;
    transform-box: fill-box;
    transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .theme-toggle-icon > * {
    transform-origin: center;
    transform-box: fill-box;
    transition:
      opacity 220ms ease,
      transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .group\/theme:hover .theme-toggle-icon {
    transform: rotate(-10deg);
  }

  .group\/theme:active .theme-toggle-icon {
    transform: rotate(8deg) scale(0.9);
  }

  .theme-toggle-icon > :nth-child(1),
  .theme-toggle-icon > :nth-child(4),
  .theme-toggle-icon > :nth-child(5) {
    opacity: 0.65;
  }

  .theme-toggle-icon > :nth-child(2) {
    transform: scale(0.92);
  }

  html.dark .group\/theme:hover .theme-toggle-icon {
    transform: rotate(10deg);
  }

  html.dark .group\/theme:active .theme-toggle-icon {
    transform: rotate(18deg) scale(0.9);
  }

  html.dark .theme-toggle-icon > :nth-child(1),
  html.dark .theme-toggle-icon > :nth-child(4),
  html.dark .theme-toggle-icon > :nth-child(5) {
    opacity: 1;
    transform: scale(1.08);
  }

  html.dark .theme-toggle-icon > :nth-child(2) {
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle-icon-shell,
    .theme-toggle-icon,
    .theme-toggle-icon > * {
      transition: none;
    }
  }
</style>
