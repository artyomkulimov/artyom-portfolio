---
import SunMoon from "@lucide/astro/icons/sun-moon";
---

<button
  type="button"
  class="group/theme inline-flex min-h-6 cursor-pointer appearance-none items-center gap-1.5 border-0 bg-transparent p-0 font-mono text-[14px] leading-6 text-neutral-500 transition-colors hover:text-neutral-800 focus-visible:text-neutral-800 focus-visible:underline focus-visible:decoration-neutral-400 focus-visible:underline-offset-4 focus-visible:outline-none dark:text-neutral-400 dark:hover:text-neutral-200 dark:focus-visible:text-neutral-200 dark:focus-visible:decoration-neutral-600"
  data-theme-toggle
  aria-label="toggle color mode"
  title="toggle theme"
>
  <span aria-hidden="true" class="theme-toggle-icon-shell">
    <SunMoon class="theme-toggle-icon h-4.5 w-4.5" />
  </span>
  <span class="theme-toggle-label" aria-hidden="true">
    <span class="theme-toggle-label-dark">dark</span>
    <span class="theme-toggle-label-light">light</span>
  </span>
</button>

<script>
  const themeToggle = document.querySelector("[data-theme-toggle]");
  const root = document.documentElement;
  const themeModeKey = "theme-mode";
  const reducedMotionQuery = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  );
  let themeTransitionTimer: number | undefined;

  try {
    localStorage.removeItem("theme");
    localStorage.removeItem("theme-preference");
  } catch {
    // Storage can be unavailable in strict browser modes.
  }

  const getCurrentTheme = () =>
    root.classList.contains("dark") ? "dark" : "light";

  const startThemeTransition = () => {
    if (reducedMotionQuery.matches) {
      return;
    }

    window.clearTimeout(themeTransitionTimer);
    root.classList.add("theme-transitioning");
    root.getBoundingClientRect();
    themeTransitionTimer = window.setTimeout(() => {
      root.classList.remove("theme-transitioning");
    }, 620);
  };

  const syncThemeButton = () => {
    if (!(themeToggle instanceof HTMLButtonElement)) {
      return;
    }

    const nextTheme = getCurrentTheme() === "dark" ? "light" : "dark";
    themeToggle.setAttribute("aria-label", `switch to ${nextTheme} mode`);
  };

  themeToggle?.addEventListener("click", () => {
    const nextTheme = getCurrentTheme() === "dark" ? "light" : "dark";
    startThemeTransition();
    root.classList.toggle("dark", nextTheme === "dark");
    try {
      localStorage.setItem(themeModeKey, nextTheme);
    } catch {
      // Storage can be unavailable in strict browser modes.
    }
    syncThemeButton();
  });

  syncThemeButton();
</script>

<style is:global>
  .theme-toggle-label {
    display: inline-block;
  }

  .theme-toggle-label-dark {
    display: none;
  }

  html.dark .theme-toggle-label-dark {
    display: inline;
  }

  html.dark .theme-toggle-label-light {
    display: none;
  }

  .theme-toggle-icon-shell {
    display: inline-flex;
    color: var(--site-accent-strong);
    transform: rotate(var(--theme-toggle-rotation, 0deg));
    transform-origin: center;
    transform-box: fill-box;
    transition:
      color 240ms ease,
      transform 420ms cubic-bezier(0.65, 0, 0.35, 1);
  }

  html.dark .theme-toggle-icon-shell {
    --theme-toggle-rotation: 180deg;
  }

  .theme-toggle-icon {
    transform-origin: center;
    transform-box: fill-box;
    transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .group\/theme:hover .theme-toggle-icon {
    transform: rotate(-10deg);
  }

  html.dark .group\/theme:hover .theme-toggle-icon {
    transform: rotate(10deg);
  }

  .group\/theme:active .theme-toggle-icon {
    transform: scale(0.9);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle-icon-shell,
    .theme-toggle-icon {
      transition: none;
    }
  }
</style>
