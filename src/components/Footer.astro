---
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";

interface Props {
  variant?: "default" | "showcase";
}

const { variant = "default" } = Astro.props;
const year = new Date().getFullYear();
---

<footer
  class:list={[
  'mb-16',
  variant === 'showcase' && 'mx-auto w-full max-w-7xl px-5 pt-8 md:px-8',
]}
>
  <ul
    class="font-sm mt-8 flex flex-col space-x-0 space-y-2 text-neutral-600 md:flex-row md:space-x-4 md:space-y-0 dark:text-neutral-300"
  >
    <li>
      <a
        class="flex items-center transition-all hover:text-neutral-800 dark:hover:text-neutral-100"
        rel="noopener noreferrer"
        target="_blank"
        href="https://github.com/artyomkulimov/"
      >
        <ArrowUpRight aria-hidden="true" class="h-3 w-3" />
        <p class="ml-2 h-7">github</p>
      </a>
    </li>
    <li>
      <a
        class="flex items-center transition-all hover:text-neutral-800 dark:hover:text-neutral-100"
        rel="noopener noreferrer"
        target="_blank"
        href="https://github.com/artyomkulimov/artyom-portfolio"
      >
        <ArrowUpRight aria-hidden="true" class="h-3 w-3" />
        <p class="ml-2 h-7">view source</p>
      </a>
    </li>
  </ul>
  <p class="mt-8 text-neutral-600 dark:text-neutral-300">
    &copy; {year} artyom kulimov
  </p>
</footer>
