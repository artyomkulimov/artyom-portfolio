---
interface Props {
  class?: string;
  name: string;
}

const { class: className = '', name } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'arrow-left' && (
    <g>
      <path d="m12 19-7-7 7-7"></path>
      <path d="M19 12H5"></path>
    </g>
  )}
  {name === 'keyboard' && (
    <g>
      <rect width="20" height="16" x="2" y="4" rx="2"></rect>
      <path d="M6 8h.01"></path>
      <path d="M10 8h.01"></path>
      <path d="M14 8h.01"></path>
      <path d="M18 8h.01"></path>
      <path d="M8 12h.01"></path>
      <path d="M12 12h.01"></path>
      <path d="M16 12h.01"></path>
      <path d="M7 16h10"></path>
    </g>
  )}
  {name === 'network' && (
    <g>
      <circle cx="12" cy="5" r="3"></circle>
      <circle cx="6" cy="19" r="3"></circle>
      <circle cx="18" cy="19" r="3"></circle>
      <path d="m10.8 7.8-3.6 8.4"></path>
      <path d="m13.2 7.8 3.6 8.4"></path>
      <path d="M9 19h6"></path>
    </g>
  )}
  {name === 'brain-circuit' && (
    <g>
      <path d="M9 3a3 3 0 0 0-3 3v1a3 3 0 0 0-2 5 3 3 0 0 0 2 5v1a3 3 0 0 0 5 2"></path>
      <path d="M15 3a3 3 0 0 1 3 3v1a3 3 0 0 1 2 5 3 3 0 0 1-2 5v1a3 3 0 0 1-5 2"></path>
      <path d="M12 5v14"></path>
      <path d="M8 9h3"></path>
      <path d="M13 9h3"></path>
      <path d="M8 15h3"></path>
      <path d="M13 15h3"></path>
      <circle cx="8" cy="9" r="1"></circle>
      <circle cx="16" cy="15" r="1"></circle>
    </g>
  )}
  {name === 'message-square' && (
    <g>
      <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"></path>
      <path d="M8 9h8"></path>
      <path d="M8 13h5"></path>
    </g>
  )}
  {name === 'camera' && (
    <g>
      <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3z"></path>
      <circle cx="12" cy="13" r="4"></circle>
    </g>
  )}
</svg>
