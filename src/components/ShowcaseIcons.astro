---
import ArrowLeft from "@lucide/astro/icons/arrow-left";
import BrainCircuit from "@lucide/astro/icons/brain-circuit";
import Camera from "@lucide/astro/icons/camera";
import Keyboard from "@lucide/astro/icons/keyboard";
import MessageSquare from "@lucide/astro/icons/message-square";
import Network from "@lucide/astro/icons/network";

interface Props {
  class?: string;
  name: string;
}

const { class: className = "", name } = Astro.props;

const icons = {
  "arrow-left": ArrowLeft,
  "brain-circuit": BrainCircuit,
  camera: Camera,
  keyboard: Keyboard,
  "message-square": MessageSquare,
  network: Network,
};

const Icon = icons[name as keyof typeof icons];
---

{Icon && <Icon aria-hidden="true" class={className} />}
