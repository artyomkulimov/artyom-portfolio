---
interface Props {
  skills: string[];
}

const { skills } = Astro.props;
---

<ul
  aria-label="skills"
  class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1.5"
>
  {skills.map((skill) => (
    <li class="group/skill inline-flex items-baseline gap-1 font-mono text-[11px] leading-5 text-neutral-600 transition-colors hover:text-neutral-800 dark:text-neutral-400 dark:hover:text-neutral-200">
      <span
        aria-hidden="true"
        class="text-neutral-400 transition-colors group-hover/skill:text-neutral-500 dark:text-neutral-600 dark:group-hover/skill:text-neutral-500"
      >
        /
      </span>
      <span class="decoration-neutral-300 underline-offset-4 transition-[color,text-decoration-color] group-hover/skill:underline dark:decoration-neutral-700">
        {skill}
      </span>
    </li>
  ))}
</ul>
