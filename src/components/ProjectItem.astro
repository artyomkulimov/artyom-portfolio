---
interface Props {
  ariaLabel?: string;
  href?: string;
  showcase?: boolean;
}

const { ariaLabel, href, showcase = false } = Astro.props;
const hitAreaLabel = ariaLabel ?? "open project";
const isClickable = Boolean(href);
---

<div
  class:list={[
    'project-item group relative pb-4',
    showcase && 'project-item-showcase',
    isClickable && 'project-item-clickable',
  ]}
  data-project-item
>
  {href && (
    <a
      class="project-item-hit-area absolute inset-0 z-10 cursor-grab active:cursor-grabbing"
      data-astro-prefetch={showcase ? "hover" : undefined}
      href={href}
    >
      <span class="sr-only">{hitAreaLabel}</span>
    </a>
  )}
  <div
    class="project-item-y absolute -left-4 -top-2 w-0.5"
    aria-hidden="true"
  ></div>
  <div
    class="project-item-x absolute -left-4 -top-2 h-0.5"
    aria-hidden="true"
  ></div>
  <div class:list={[isClickable && 'pointer-events-none relative z-20']}>
    <slot />
  </div>
</div>

<script>
  const setupMobileProjectMotion = () => {
    const items = Array.from(document.querySelectorAll("[data-project-item]"));

    if (!items.length) {
      return;
    }

    const mobileMotionQuery = window.matchMedia(
      "(hover: none), (pointer: coarse)"
    );
    let cleanupHandlers: Array<() => void> = [];

    const teardown = () => {
      for (const cleanup of cleanupHandlers) {
        cleanup();
      }
      cleanupHandlers = [];

      for (const item of items) {
        item.classList.remove("is-mobile-pressed");
      }
    };

    const apply = () => {
      teardown();

      if (!mobileMotionQuery.matches) {
        return;
      }

      for (const item of items) {
        let releaseTimer: number | undefined;

        const press = () => {
          window.clearTimeout(releaseTimer);
          item.classList.add("is-mobile-pressed");
        };

        const release = () => {
          window.clearTimeout(releaseTimer);
          releaseTimer = window.setTimeout(() => {
            item.classList.remove("is-mobile-pressed");
          }, 520);
        };

        item.addEventListener("pointerdown", press, { passive: true });
        item.addEventListener("pointerup", release, { passive: true });
        item.addEventListener("pointercancel", release, { passive: true });
        item.addEventListener("pointerleave", release, { passive: true });

        cleanupHandlers.push(() => {
          window.clearTimeout(releaseTimer);
          item.removeEventListener("pointerdown", press);
          item.removeEventListener("pointerup", release);
          item.removeEventListener("pointercancel", release);
          item.removeEventListener("pointerleave", release);
        });
      }
    };

    apply();
    mobileMotionQuery.addEventListener("change", apply);
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupMobileProjectMotion, {
      once: true,
    });
  } else {
    setupMobileProjectMotion();
  }
</script>
