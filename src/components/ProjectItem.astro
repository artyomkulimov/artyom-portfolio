---
interface Props {
  ariaLabel?: string;
  href?: string;
  showcase?: boolean;
}

const { ariaLabel, href, showcase = false } = Astro.props;
const hitAreaLabel = ariaLabel ?? "open project";
const isClickable = Boolean(href);
---

<div
  class:list={[
    'project-item group relative pb-4',
    showcase && 'project-item-showcase',
    isClickable && 'project-item-clickable',
  ]}
  data-project-item
>
  {href && (
    <a
      class="project-item-hit-area absolute inset-0 z-10 cursor-pointer"
      data-astro-prefetch={showcase ? "hover" : undefined}
      href={href}
    >
      <span class="sr-only">{hitAreaLabel}</span>
    </a>
  )}
  <div
    class="project-item-y absolute -left-4 -top-2 w-0.5"
    aria-hidden="true"
  ></div>
  <div
    class="project-item-x absolute -left-4 -top-2 h-0.5"
    aria-hidden="true"
  ></div>
  <div class:list={[isClickable && 'relative z-20']}>
    <slot />
  </div>
</div>

<script>
  const interactiveSelector = [
    "a",
    "button",
    "input",
    "select",
    "textarea",
    "summary",
    "[role='button']",
    "[role='link']",
  ].join(",");

  const setupProjectNavigation = () => {
    const items = Array.from(
      document.querySelectorAll(".project-item-clickable")
    );

    for (const item of items) {
      const hitArea = item.querySelector(".project-item-hit-area");

      if (!(hitArea instanceof HTMLAnchorElement)) {
        continue;
      }

      item.addEventListener("click", (event) => {
        const target = event.target;

        if (
          !(target instanceof Element) ||
          target.closest(interactiveSelector)
        ) {
          return;
        }

        if (event.metaKey || event.ctrlKey) {
          window.open(hitArea.href, "_blank", "noopener,noreferrer");
          return;
        }

        window.location.href = hitArea.href;
      });
    }
  };

  const setupShowcaseChevronMotion = () => {
    const items = Array.from(
      document.querySelectorAll(".project-item-showcase")
    );
    const reducedMotionQuery = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    );
    const cleanupHandlers: Array<() => void> = [];

    for (const item of items) {
      let startTimer: number | undefined;
      let loopTimer: number | undefined;

      const clearTimers = () => {
        window.clearTimeout(startTimer);
        window.clearInterval(loopTimer);
      };

      const reset = () => {
        clearTimers();
        item.classList.remove("is-showcase-chevron-forward");
      };

      const start = () => {
        reset();

        if (reducedMotionQuery.matches) {
          return;
        }

        startTimer = window.setTimeout(() => {
          let isForward = true;
          item.classList.add("is-showcase-chevron-forward");

          loopTimer = window.setInterval(() => {
            isForward = !isForward;
            item.classList.toggle("is-showcase-chevron-forward", isForward);
          }, 520);
        }, 40);
      };

      const maybeResetFocus = (event: FocusEvent) => {
        const nextTarget = event.relatedTarget;

        if (nextTarget instanceof Node && item.contains(nextTarget)) {
          return;
        }

        reset();
      };

      item.addEventListener("pointerenter", start);
      item.addEventListener("pointerleave", reset);
      item.addEventListener("focusin", start);
      item.addEventListener("focusout", maybeResetFocus);

      cleanupHandlers.push(() => {
        reset();
        item.removeEventListener("pointerenter", start);
        item.removeEventListener("pointerleave", reset);
        item.removeEventListener("focusin", start);
        item.removeEventListener("focusout", maybeResetFocus);
      });
    }

    reducedMotionQuery.addEventListener("change", () => {
      if (reducedMotionQuery.matches) {
        for (const cleanup of cleanupHandlers) {
          cleanup();
        }
      }
    });
  };

  const setupMobileProjectMotion = () => {
    const items = Array.from(document.querySelectorAll("[data-project-item]"));

    if (!items.length) {
      return;
    }

    const mobileMotionQuery = window.matchMedia(
      "(hover: none), (pointer: coarse)"
    );
    let cleanupHandlers: Array<() => void> = [];

    const teardown = () => {
      for (const cleanup of cleanupHandlers) {
        cleanup();
      }
      cleanupHandlers = [];

      for (const item of items) {
        item.classList.remove("is-mobile-pressed");
      }
    };

    const apply = () => {
      teardown();

      if (!mobileMotionQuery.matches) {
        return;
      }

      for (const item of items) {
        let releaseTimer: number | undefined;

        const press = () => {
          window.clearTimeout(releaseTimer);
          item.classList.add("is-mobile-pressed");
        };

        const release = () => {
          window.clearTimeout(releaseTimer);
          releaseTimer = window.setTimeout(() => {
            item.classList.remove("is-mobile-pressed");
          }, 520);
        };

        item.addEventListener("pointerdown", press, { passive: true });
        item.addEventListener("pointerup", release, { passive: true });
        item.addEventListener("pointercancel", release, { passive: true });
        item.addEventListener("pointerleave", release, { passive: true });

        cleanupHandlers.push(() => {
          window.clearTimeout(releaseTimer);
          item.removeEventListener("pointerdown", press);
          item.removeEventListener("pointerup", release);
          item.removeEventListener("pointercancel", release);
          item.removeEventListener("pointerleave", release);
        });
      }
    };

    apply();
    mobileMotionQuery.addEventListener("change", apply);
  };

  if (document.readyState === "loading") {
    document.addEventListener(
      "DOMContentLoaded",
      () => {
        setupProjectNavigation();
        setupShowcaseChevronMotion();
        setupMobileProjectMotion();
      },
      { once: true }
    );
  } else {
    setupProjectNavigation();
    setupShowcaseChevronMotion();
    setupMobileProjectMotion();
  }
</script>
