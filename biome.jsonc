{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/astro"],
  "assist": {
    "actions": {
      "source": {
        "useSortedAttributes": "off"
      }
    }
  },
  "linter": {
    "rules": {
      "nursery": {
        "useSortedClasses": "off"
      },
      "style": {
        "useFilenamingConvention": "off"
      }
    }
  }
}
